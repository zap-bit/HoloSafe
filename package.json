{
  "name": "holosafe",
  "private": true,
  "scripts": {
    "setup": "cd backend && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt && cd ../frontend && npm install && cd .. && npm install",
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cd backend && .venv/bin/python run.py",
    "dev:web": "cd frontend && npm run dev",
    "reset": "cd backend && .venv/bin/python -m seed.seed"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
