# NVIDIA Nemotron (OpenAI-compatible API). Copy to .env and fill in.
NEMOTRON_API_KEY=
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
# live = call Nemotron (auto-falls back to mock on error/timeout); mock = deterministic, no network
AGENT_MODE=live
# seconds before a live agent call falls back to mock
AGENT_TIMEOUT=20
